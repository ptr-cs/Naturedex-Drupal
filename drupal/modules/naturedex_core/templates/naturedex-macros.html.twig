{#
/**
 * @file
 * Small markup helpers shared by the Naturedex templates.
 */
#}
{% macro icon(name, size = 20) %}
  {%- set paths = {
    book: '<path d="M4 4h6l2 2 2-2h6v15h-6l-2 2-2-2H4z"/><path d="M12 6v15M7 8h2M15 8h2M7 12h2M15 12h2"/>',
    map: '<path d="m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2zM9 3v16M15 5v16"/>',
    pen: '<path d="m15 4 5 5M4 20l2-7L17 2l5 5L11 18zM4 20l7-2"/>',
    search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>',
    leaf: '<path d="M20 3C8 2 3 7 5 14s13 9 15-11Z"/><path d="m4 21 12-12M10 15v-5M10 15h5"/>',
    arrow: '<path d="M4 12h16m-6-6 6 6-6 6"/>',
    check: '<path d="m5 12 4 4 10-10"/>',
    close: '<path d="m5 5 14 14M19 5 5 19"/>',
    globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c-6 6-6 12 0 18 6-6 6-12 0-18Z"/>',
    info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7v1"/>',
    eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  } -%}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">{{ (paths[name] ?? paths.leaf)|raw }}</svg>
{%- endmacro %}

{# A sprite. The frontend swaps in data-animated-src when motion is on. #}
{% macro sprite(species, size, alt = '', lazy = false) %}
  <img src="{{ species.sprite }}" alt="{{ alt }}" width="{{ size }}" height="{{ size }}" data-sprite="{{ species.id }}" data-animated="false"{% if species.animatedSprite %} data-animated-src="{{ species.animatedSprite }}"{% endif %}{% if lazy %} loading="lazy"{% endif %}>
{%- endmacro %}

{% macro dex(number) %}NO. {{ '%03d'|format(number) }}{% endmacro %}

{% macro range(values, unit) %}{{ values ? values[0] ~ '–' ~ values[1] ~ ' ' ~ unit : 'See field notes' }}{% endmacro %}
