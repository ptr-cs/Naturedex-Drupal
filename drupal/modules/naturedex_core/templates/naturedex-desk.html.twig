{#
/**
 * @file
 * The Writing desk.
 *
 * Available variables:
 * - config: JSON with the API root, a CSRF token, and where to refresh it.
 * - species: Species records for the related-animal picker.
 * - can_publish: Whether this account may publish.
 * - account_name: The signed-in person's display name.
 */
#}
{% import '@naturedex_core/naturedex-macros.html.twig' as nd %}
<div id="writing-desk">
  <script type="application/json" id="naturedex-desk-config">{{ config }}</script>
  <noscript><p class="error-message">The writing desk needs JavaScript. You can also write in <a href="{{ path('node.add', {node_type: 'field_note'}) }}">Drupal</a>.</p></noscript>
  <div class="section-toolbar">
    <p>Write a little. Share a discovery. Signed in as {{ account_name }}.</p>
    <div class="desk-account">
      {% if can_publish %}<a class="text-link" href="{{ path('system.admin_content') }}">Drupal content</a>{% endif %}
      <a class="text-link" href="{{ path('user.logout') }}">Sign out</a>
      <button class="primary-button" type="button" data-desk-new><span aria-hidden="true">＋</span> New post</button>
    </div>
  </div>
  <p class="status-message" role="status" data-desk-message></p>
  <p class="error-message" role="alert" data-desk-error hidden></p>

  <form class="editor-form panel" data-desk-form hidden>
    <div class="editor-heading">
      <h2 data-desk-form-title>A fresh page.</h2>
      <button type="button" class="text-link" data-desk-cancel>Cancel editing</button>
    </div>
    <label>Title <input name="title" required maxlength="160"></label>
    <div class="form-row">
      <label>
        <span id="post-slug-label">Slug</span>
        <input name="slug" aria-labelledby="post-slug-label" aria-describedby="post-slug-help" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="180">
        <small id="post-slug-help">Lowercase words separated by hyphens.</small>
      </label>
      <label>Category <input name="category" required maxlength="80"></label>
    </div>
    <label>Excerpt <textarea name="excerpt" required maxlength="500" rows="2"></textarea></label>
    <div class="body-label">
      <label for="post-body">Body</label>
      <button type="button" class="text-link" data-desk-preview-toggle aria-pressed="false">Preview article</button>
    </div>
    <section class="editor-preview" aria-label="Article preview" data-desk-preview hidden></section>
    <textarea id="post-body" name="body" required rows="13" maxlength="50000"></textarea>
    <p class="fine-print">Separate paragraphs with a blank line. Use ## for section headings. Text is rendered safely; HTML is not executed. Drupal’s own editor uses the same format.</p>
    <div class="form-row">
      <label>
        <span id="post-status-label">Status</span>
        <select name="status" aria-labelledby="post-status-label"{% if not can_publish %} aria-describedby="post-status-help"{% endif %}>
          <option value="draft">Draft</option>
          <option value="published"{% if not can_publish %} disabled{% endif %}>Published</option>
        </select>
        {% if not can_publish %}
          <small id="post-status-help">Your account saves drafts. An editor publishes them.</small>
        {% endif %}
      </label>
    </div>
    <fieldset class="related-picker">
      <legend>Related animals</legend>
      <div class="related-options">
        {% for option in species %}
          <label><input type="checkbox" name="relatedSpeciesIds" value="{{ option.id }}"> {{ option.name }}</label>
        {% endfor %}
      </div>
    </fieldset>
    <div class="editor-actions">
      <p class="fine-print">Saved to Drupal, with revision history.</p>
      <button type="submit" class="primary-button" data-desk-save><span data-desk-save-label>Save post</span> {{ nd.icon('check', 16) }}</button>
    </div>
  </form>

  <div class="editor-list" data-desk-list></div>
  <div class="empty-state" data-desk-empty hidden>
    {{ nd.icon('pen', 36) }}
    <h2>Your journal starts here.</h2>
    <p>Create your first field note, save a draft, and publish when you’re ready.</p>
  </div>

  <template data-desk-row-icon>{{ nd.icon('pen', 16) }}</template>
</div>
