<mxfile host="naturedex-diagram"><diagram id="Naturedex Drupal on AWS" name="Naturedex Drupal on AWS"><mxGraphModel dx="2320" dy="1640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1640" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:36px&quot;&gt;Naturedex Drupal on AWS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1600" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;span style=&quot;font-size:19px;color:#545B64&quot;&gt;Deployed infrastructure in us-east-1. Visitors reach the site only through CloudFront and WAF. Drupal keeps all of its state in the database, so there is no shared file storage.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="68" width="1900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="AWS Cloud, us-east-1" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#232F3E;strokeColor=#232F3E;fillColor=none;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="272" y="130" width="1984" height="1462" as="geometry"/></mxCell><mxCell id="c4" value="VPC, 2 Availability Zones, no NAT gateway" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#7D3AC1;strokeColor=#8C4FFF;fillColor=none;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="620" y="252" width="1094" height="848" as="geometry"/></mxCell><mxCell id="c5" value="Private subnets" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#147EBA;strokeColor=#9ABED6;fillColor=#EEF5FA;strokeWidth=1;container=0;" vertex="1" parent="1"><mxGeometry x="652" y="316" width="276" height="752" as="geometry"/></mxCell><mxCell id="c6" value="Public subnets&lt;br&gt;No inbound" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#248814;strokeColor=#A9CC96;fillColor=#EFF6EC;strokeWidth=1;container=0;" vertex="1" parent="1"><mxGeometry x="961" y="316" width="328" height="752" as="geometry"/></mxCell><mxCell id="c7" value="Private subnets&lt;br&gt;No internet route" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#147EBA;strokeColor=#9ABED6;fillColor=#EEF5FA;strokeWidth=1;container=0;" vertex="1" parent="1"><mxGeometry x="1322" y="316" width="360" height="752" as="geometry"/></mxCell><mxCell id="c8" value="Deployment" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#248814;strokeColor=#248814;fillColor=none;strokeWidth=1;dashed=1;container=0;" vertex="1" parent="1"><mxGeometry x="297" y="1150" width="610" height="425" as="geometry"/></mxCell><mxCell id="c9" value="Operations and alerting" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#7D3AC1;strokeColor=#8C4FFF;fillColor=none;strokeWidth=1;dashed=1;container=0;" vertex="1" parent="1"><mxGeometry x="937" y="1150" width="1293" height="425" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:17px&quot;&gt;Visitors and editors&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="102" y="496" width="76" height="76" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;font-size:17px&quot;&gt;AWS WAF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;6 rules, rate limits,&lt;br&gt;install scripts blocked&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1"><mxGeometry x="402" y="290" width="72" height="72" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:17px&quot;&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;HTTPS, 5-minute page cache&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="402" y="498" width="72" height="72" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&quot;font-size:17px&quot;&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1"><mxGeometry x="1088" y="219" width="66" height="66" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style=&quot;font-size:16px&quot;&gt;Internet gateway&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1165" y="222" width="220" height="26" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&quot;font-size:17px&quot;&gt;Application Load&lt;br&gt;Balancer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Internal, no public IP&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1"><mxGeometry x="750" y="498" width="72" height="72" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;font-size:17px&quot;&gt;ECS on Fargate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Drupal 11 on Apache&lt;br&gt;0.5 vCPU, 1 GB, ARM&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="1085" y="498" width="72" height="72" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&quot;font-size:17px&quot;&gt;One-off Fargate tasks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Hourly cron, first install,&lt;br&gt;cache rebuild&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="1085" y="794" width="72" height="72" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;font-size:17px&quot;&gt;Amazon RDS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;MySQL 8.4, db.t4g.micro&lt;br&gt;encrypted, 7-day backups&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#3B48CC;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="1465" y="644" width="72" height="72" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;font-size:17px&quot;&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Database logins, hash salt,&lt;br&gt;admin password&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1936" y="330" width="72" height="72" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:17px&quot;&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Container image&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="1936" y="524" width="72" height="72" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;font-size:17px&quot;&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Container and WAF logs&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1936" y="718" width="72" height="72" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;arcSize=12;html=1;strokeColor=none;fillColor=#24292F;" vertex="1" parent="1"><mxGeometry x="104" y="1204" width="72" height="72" as="geometry"/></mxCell><mxCell id="c23" value="&amp;lt;/&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;fontSize=30;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="104" y="1204" width="72" height="72" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&quot;font-size:17px&quot;&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Tests, then a manual,&lt;br&gt;approved deploy&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#232F3E;fontSize=14;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="1280" width="280" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&quot;font-size:17px&quot;&gt;IAM role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;GitHub OIDC, no stored keys&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="402" y="1204" width="72" height="72" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style=&quot;font-size:17px&quot;&gt;CloudFormation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Created with AWS CDK&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="402" y="1404" width="72" height="72" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&quot;font-size:17px&quot;&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Cache rebuild after each&lt;br&gt;release (custom resource)&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="724" y="1404" width="72" height="72" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&quot;font-size:17px&quot;&gt;EventBridge rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;Hourly Drupal cron&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="1085" y="1204" width="72" height="72" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&quot;font-size:17px&quot;&gt;CloudWatch alarms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64;font-size:14px&quot;&gt;No healthy task, 5xx errors,&lt;br&gt;low database storage&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.reso